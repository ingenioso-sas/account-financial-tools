<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_transfer_pos_payment_wizard_form" model="ir.ui.view">
        <field name="name">move.transfer.pos.payment.wizard.form</field>
        <field name="model">move.transfer.pos.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer POS Payments">
                <group>
                    <field name="transfer_account_source_id"/>
                    <field name="transfer_account_destination_id"/>
                </group>
                <footer>
                    <button name="create_transfer" string="Create Transfer" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_move_transfer_pos_payment_wizard" model="ir.actions.act_window">
        <field name="name">Create Transfer Journal Entry</field>
        <field name="res_model">move.transfer.pos.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="point_of_sale.model_pos_payment"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
